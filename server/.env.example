# Set these as process environment variables; this file is documentation only.
DATABASE_URL=jdbc:postgresql://127.0.0.1:55432/weave
DATABASE_USER=weave
DATABASE_PASSWORD=
# Generate a random secret of at least 32 bytes, or use scripts/start-server.ps1.
WEAVE_TOKEN_SECRET=
PORT=8080
WEAVE_BIND=127.0.0.1
WEAVE_ORIGINS=http://127.0.0.1:5187,http://localhost:5187
WEAVE_TEST_DATABASE_URL=jdbc:postgresql://127.0.0.1:55432/weave?currentSchema=weave_phase2_test

REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_PASSWORD=
WEAVE_REDIS_ENABLED=true
WEAVE_REDIS_CHANNEL=weave:boards:v1
WEAVE_COMPACTION_THRESHOLD=1000
WEAVE_COMPACTION_INTERVAL_MS=60000
WEAVE_SYNC_SWEEP_MS=2000
WEAVE_OPERATIONS_PER_SECOND=100
WEAVE_OPERATION_BURST=200
WEAVE_TOKEN_LIFETIME_SECONDS=604800

# Optional host components when DATABASE_URL is omitted:
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=55432
# DATABASE_NAME=weave
# Render supplies REDIS through SPRING_DATA_REDIS_URL and uses RENDER_EXTERNAL_URL
# as the allowed Origin when WEAVE_ORIGINS is omitted.

WEAVE_CLOCK_TOLERANCE_MS=30000
WEAVE_REPLICA_LEASE_SECONDS=300
WEAVE_VIRTUAL_THREADS=true
